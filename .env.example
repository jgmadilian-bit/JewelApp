# ---------------------------------------------------------------------------
# JewelApp environment
# Copy this file to ".env" and fill in your Supabase project values.
# Anything prefixed with EXPO_PUBLIC_ is embedded in the app bundle and is
# therefore safe to ship to clients (it is the public anon key, never the
# service_role key).
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Public anon key (Project Settings -> API -> anon public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
