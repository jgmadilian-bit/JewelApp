{
  "expo": {
    "name": "JewelApp",
    "slug": "JewelApp",
    "version": "1.0.0",
    "scheme": "jewelapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jewelapp.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jewelapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock JewelApp with Face ID so you never have to log in again."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JewelApp needs access to your photos so you can attach stone images to a listing.",
          "cameraPermission": "JewelApp needs camera access so you can photograph a stone or its certificate."
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#D4AF37"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
